@startuml
skinparam shadowing false
skinparam activity {
  BackgroundColor White
  BorderColor Black
}
title ASII-25 — Actividad de pipeline de pruebas, quality gates y release

start
:ACT-PLN-01\nPlanificar matriz de pruebas y criterios de aceptación;
:Desarrollador abre Pull Request en GitHub;
:ACT-PLN-02\nDisparar pipeline de CI en GitHub Actions Runner;

:ACT-LNT-01\nEjecutar análisis estático y linters (Pint, PHPStan, ESLint);
if (¿Linting exitoso?) then (Sí)
  :Continuar a pruebas unitarias y BD;
else (No)
  :ACT-EX-01\nRegistrar fallo de linting y estilo;
  :ACT-EX-05\nBloquear PR y reportar errores al Desarrollador;
  stop
endif

:ACT-UNT-01\nAprovisionar arnés efímero PostgreSQL (central y hospital);
:ACT-UNT-02\nEjecutar pruebas unitarias y de integración de base de datos;
if (¿Pruebas unitarias y BD aprobadas?) then (Sí)
  :Continuar a suite E2E;
else (No)
  :ACT-EX-02\nRegistrar fallo en pruebas unitarias o integridad BD;
  :ACT-EX-05\nBloquear PR y reportar errores al Desarrollador;
  stop
endif

:ACT-E2E-01\nDesplegar entorno efímero para pruebas E2E;
:ACT-E2E-02\nEjecutar suite de flujos clínicos (admisión, recetas, agenda);
if (¿Suites E2E 100% exitosas?) then (Sí)
  :Continuar a validación de Quality Gate;
else (No)
  :ACT-EX-03\nRegistrar fallo o regresión en pruebas E2E;
  :ACT-EX-05\nBloquear PR y reportar errores al Desarrollador;
  stop
endif

:ACT-QG-01\nEvaluar umbrales de Quality Gate (cobertura >= 80%, 0 críticos);
if (¿Cumple políticas de Quality Gate?) then (Sí)
  :ACT-ART-01\nConsolidar artefactos (JUnit XML, LCOV, videos E2E);
  :ACT-ART-02\nGenerar digest SHA-256 y almacenar evidencia inmutable;
  :ACT-REL-01\nDictaminar aprobación del PR y autorizar merge;
  if (¿Integración a rama de release main?) then (Sí)
    :ACT-REL-02\nGenerar release tag semántico inmutable (vX.Y.Z);
  else (No)
    :Merge completado en rama develop;
  endif
  stop
else (No)
  :ACT-EX-04\nRegistrar incumplimiento de umbrales de Quality Gate;
  :ACT-EX-05\nBloquear PR y reportar errores al Desarrollador;
  stop
endif
@enduml
